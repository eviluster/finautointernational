{
  "extends": "@vue/tsconfig/tsconfig.web.json",
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "lib": ["es2017"],
    "ignoreDeprecations": "5.0",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "references": [
    {
      "path": "./tsconfig.config.json"
    }
  ]
}
