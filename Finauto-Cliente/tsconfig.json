{
  "compilerOptions": {
    "target": "esnext", // o "es2017", según prefieras
    "module": "esnext",
    "lib": ["es2015", "dom", "ES2017"], // <— aquí está la clave: incluir "es2015"
    "jsx": "preserve",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.js"]
}
